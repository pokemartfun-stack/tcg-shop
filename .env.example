# Copy to .env and fill in for live payments. Leave blank for demo mode.

# Stripe (card + Apple Pay via Checkout / Payment Element)
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# PayPal JS SDK client ID
# Get from https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=

# Server
PORT=3847
BASE_URL=http://localhost:3847
