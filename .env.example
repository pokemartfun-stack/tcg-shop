# Copy to .env and fill in for live payments. Leave blank for demo mode.

# Stripe (card + Apple Pay via Checkout / Payment Element)
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_...) from Developers → Webhooks, endpoint /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# PayPal JS SDK client ID
# Get from https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=

# Royal Mail Click & Drop (send paid orders, print Tracked 48 labels, sync tracking numbers).
# Key from Click & Drop > Settings > Integrations > Click & Drop API (expand the row). Add it on Render
# yourself; never share it. Blank = "not connected" (everything else works as now).
# Printing labels through the API needs a Royal Mail Online Business Account (OBA).
ROYALMAIL_API_KEY=
# Optional: Click & Drop service code (default TPS48 = Royal Mail Tracked 48)
ROYALMAIL_SERVICE_CODE=

# Server
PORT=3847
BASE_URL=http://localhost:3847

# Owner admin page at /admin — leave blank to disable it
ADMIN_PASSWORD=

# Optional: save admin changes back to GitHub so they survive Render restarts.
# Fine-grained token with "Contents: Read and write" on the tcg-shop repo only.
GITHUB_TOKEN=
GITHUB_REPO=pokemartfun-stack/tcg-shop
GITHUB_BRANCH=main

# Optional: customer-service email shown on Contact us / FAQ / Privacy / Terms (mailto link).
# Blank = the pages show "[CONTACT EMAIL — to confirm]".
CONTACT_EMAIL=
# Optional: customer order emails (order confirmation + "posted" with Royal Mail tracking), sent from the
# shop Gmail account. Set BOTH GMAIL_USER and GMAIL_APP_PASSWORD to turn them on; blank = emails are off
# and the shop works exactly as before. Set these on Render (tcg-shop-1 -> Environment) yourself — never
# put real values in this file or in chat. See README "Customer order emails".
GMAIL_USER=
# A Google *app password* (16 letters), NOT your normal Gmail password.
GMAIL_APP_PASSWORD=
# Optional: sender name shown to buyers (default "Po-ke Mart Fun").
MAIL_FROM_NAME=
# Optional: used for the links in emails (default https://tcg-shop-1.onrender.com).
SHOP_URL=
# (CONTACT_EMAIL above, if set, is the contact address printed in emails; otherwise GMAIL_USER is used.)
# Optional: shown on the PDF reports / receipts (company name + number are built in). Blank = shown as
# "[REGISTERED ADDRESS — to confirm]" / "[VAT STATUS / NUMBER — to confirm]". Never invent these.
COMPANY_ADDRESS=
VAT_NUMBER=
# Optional (tests / local): where the accounting ledger is kept when ORDERS_GITHUB_REPO isn't set. Default data/ledger.json.
LEDGER_FILE=
# Optional: yes = show the demo products that only have placeholder art again (hidden by default).
SHOW_PLACEHOLDER_LISTINGS=
