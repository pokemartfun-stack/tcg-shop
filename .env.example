# Copy to .env and fill in for live payments. Leave blank for demo mode.

# Stripe (card + Apple Pay via Checkout / Payment Element)
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_...) from Developers → Webhooks, endpoint /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# PayPal JS SDK client ID
# Get from https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=

# Server
PORT=3847
BASE_URL=http://localhost:3847

# Owner admin page at /admin — leave blank to disable it
ADMIN_PASSWORD=

# Optional: save admin changes back to GitHub so they survive Render restarts.
# Fine-grained token with "Contents: Read and write" on the tcg-shop repo only.
GITHUB_TOKEN=
GITHUB_REPO=pokemartfun-stack/tcg-shop
GITHUB_BRANCH=main
